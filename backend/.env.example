# Database
DATABASE_URL="mysql://root:password@localhost:3306/smartguide"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# App
# Public URL visitors use (the frontend origin). Used in QR codes and upload URLs.
APP_URL="http://localhost:5173"

# File Storage
UPLOAD_DIR="../uploads"
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=20

# Server
PORT=4000
NODE_ENV=development
